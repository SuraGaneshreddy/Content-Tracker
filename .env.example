# =====================================================================
#  PERSONAL CONTENT TRACKER — environment configuration
#  Copy this file to `.env` and edit. Every value has a safe default,
#  so the app runs with NO external API keys configured.
# =====================================================================

# --- App ---------------------------------------------------------------
APP_NAME="Personal Content Tracker"
APP_ENV=development                 # development | production
# Change this. Any long random string. Used to sign session + CSRF tokens.
SECRET_KEY=change-me-to-a-long-random-string
# Public base URL, used when building password-reset links.
PUBLIC_BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# --- Database ----------------------------------------------------------
# SQLite by default (zero setup). Any SQLAlchemy URL works, e.g.
#   postgresql+psycopg://user:pass@localhost:5432/tracker
DATABASE_URL=sqlite:///data/tracker.db

# --- Security ----------------------------------------------------------
SESSION_COOKIE_NAME=pct_session
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_MINUTES=10080          # rolling idle timeout (7 days)
REMEMBER_ME_DAYS=90
PASSWORD_MIN_LENGTH=8
# Login / register / reset rate limit: N requests per window per IP.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
# Optional extra secret mixed into every password hash. Set once and never change it.
PCT_PASSWORD_PEPPER=
# Reject import/restore uploads larger than this many megabytes.
MAX_UPLOAD_MB=12

# --- Outbound network (SSRF-safe fetcher) ------------------------------
FETCH_TIMEOUT_SECONDS=8
FETCH_MAX_BYTES=1048576             # 1 MiB cap per external fetch
FETCH_ALLOWED_PORTS=80,443
FETCH_BLOCK_PRIVATE_NETWORKS=true   # keep true. Blocks localhost/LAN/cloud metadata.
FETCH_MAX_REDIRECTS=3
# Global outbound request budget (per-host and per-run throttling).
FETCH_MIN_INTERVAL_PER_HOST_SECONDS=30
FETCH_MAX_REQUESTS_PER_RUN=60

# --- Background scheduler ---------------------------------------------
ENABLE_SCHEDULER=true
CHECK_INTERVAL_MINUTES=90           # how often URL health + update checks run
URL_HEALTH_INTERVAL_HOURS=24        # re-check a link at most this often
UPDATE_CHECK_INTERVAL_HOURS=12      # re-check for new chapters/episodes at most this often

# --- Optional external APIs (all optional; leave blank to disable) ------
# TMDB — movie/cinema metadata + upcoming releases. https://www.themoviedb.org
TMDB_API_KEY=
TMDB_API_READ_TOKEN=
# Jikan (MyAnimeList unofficial public API) — needs no key, disable if you prefer.
JIKAN_ENABLED=true
# NewsAPI.org — news headlines. https://newsapi.org
NEWSAPI_KEY=
# ESPN public JSON endpoints for sports — needs no key.
ESPN_ENABLED=true
# RSS feeds are used for news/coding/sports when no API key is present.
RSS_ENABLED=true

# --- Metadata scraping of user-supplied URLs --------------------------
ENABLE_URL_METADATA_SCRAPING=true
# Thumbs are cached to disk so we do not hotlink or re-download repeatedly.
ENABLE_THUMBNAIL_CACHE=true
THUMBNAIL_WIDTH=320
THUMBNAIL_HEIGHT=460
